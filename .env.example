# Copy to .env and adjust paths before running Docker Compose.

# Bind to 127.0.0.1 for SSH tunnel access, or to the server's VPN/LAN IP.
# Do not set this to 0.0.0.0 unless the host firewall blocks public access.
FINREP_BIND_ADDRESS=127.0.0.1

FINREP_DASH_PORT=8050
FINREP_DASH_DEBUG=0
FINREP_DASH_HOT_RELOAD=0

# Leave both blank for read-only demo. Set both to unique secrets to enable LIVE.
# Keep real values only in the git-ignored .env file; never use example passwords.
FINREP_DASH_PASSWORD=
FINREP_DASH_SECRET_KEY=

# Live mode data. Test mode always uses the bundled read-only sample_data.
FINREP_DATA_DIR=./data
FINREP_REPORTS_DIR=./reports
FINREP_STORAGE_BACKEND=sqlite
# FINREP_SQLITE_PATH=/app/data/finrep.sqlite3

# Private server example:
# FINREP_DATA_DIR=/srv/finrep/data
# FINREP_REPORTS_DIR=/srv/finrep/reports
